{
  "name": "where-did-my-time-go",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:generate": "npm run generate -w @wheredidmytimego/db",
    "db:migrate": "npm run migrate -w @wheredidmytimego/db",
    "db:studio": "npm run studio -w @wheredidmytimego/db"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
